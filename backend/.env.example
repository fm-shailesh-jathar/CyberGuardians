# Enable external web fallback (choose one provider)
# - gemini: Gemini with Google Search grounding (requires SECUREAUDIT_GEMINI_API_KEY)
# - serper: Google via Serper API (requires SECUREAUDIT_SERPER_API_KEY)
# - bing: Bing Web Search (requires SECUREAUDIT_BING_API_KEY)
SECUREAUDIT_WEB_PROVIDER=gemini

# Gemini API key (Google AI Studio) + model
SECUREAUDIT_GEMINI_API_KEY=REPLACE_ME
SECUREAUDIT_GEMINI_MODEL=gemini-2.5-flash

# Gemini grounding can be slower than local KB; increase if you see timeouts.
SECUREAUDIT_GEMINI_TIMEOUT=25

# Serper API key (if using serper)
# SECUREAUDIT_WEB_PROVIDER=serper
# SECUREAUDIT_SERPER_API_KEY=REPLACE_ME

# Bing API key (if using bing)
# SECUREAUDIT_WEB_PROVIDER=bing
# SECUREAUDIT_BING_API_KEY=REPLACE_ME

# Optional tuning
SECUREAUDIT_WEB_MAX_RESULTS=3
SECUREAUDIT_WEB_TIMEOUT=8

# Optional: allow KB candidate reranking using Ollama
SECUREAUDIT_LLM_RERANK=1
